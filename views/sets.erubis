<!DOCTYPE HTML>
<html lang=en>

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
  <title><%= @config[:title] %></title>
  <link rel="stylesheet" href="/css/vqvz.css"
    type="text/css" media="screen" title="default style sheet" charset="utf-8" />
</head>

<body>
<%= erubis(:_gallery_banner, :layout => false) %>
<div id="content">
    <div id="header">
        <h2>Sets</h2>
    </div>
    <div class="photo">
    <table id="sets">
    <% @sets.each do |set| %>
    <tr>
      <td><a href="/set/<%= set.slug %>"><img src="<%= set.thumbnail %>" /></a></td>
      <td><h3><a href="/set/<%= set.slug %>"><%= set.title %></a></h3></td>
    </tr>
    <% end %>
    </table>
    <p style="color:gray;margin-top:5em">Everything here is copyright Ramanan Sivaranjan 2009.</p>
    </div>
</div>
<%= erubis(:_google_analytics, :layout => false) %>
</body>

</html>

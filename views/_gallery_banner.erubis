<div id="gallery-banner">
	<table cellspacing="0" cellpadding="0"><tr>
	<td>
    	<h1><a href="http://funkaoshi.com/">A Funkaoshi Production</a> presents <a href="/"><%= @config[:title] %></a>.</h1>
    </td>
	<td align="right">
        What's Here: <a href="/">Home</a> | <a href="/about">About</a> | <a href="/news">News</a> | <a href="/sets">Sets</a>
        <% unless @page == 0 || @show_nav.nil? %>
        &nbsp; &nbsp; Look Around: <% if @page > 1 %><a href="/<% unless @page - 1 == 1 %>/page/<%= @page - 1 %><% end %>" class="prev_page">Prev</a><% else %>Prev<% end %>
        | <a href="/">Home</a> | 
        <% if @page < @pages %><a href="/page/<%= @page + 1 %>" class="next_page">Next</a><% else %>Next<% end %>
        <% end %>
    </td>
    </tr></table>
</div>

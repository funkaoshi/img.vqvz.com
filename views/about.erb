<!DOCTYPE HTML>
<html lang=en>

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
  <title>IMG VQVZ :: ABOUT</title>
  <link rel="stylesheet" href="/css/vqvz.css"
    type="text/css" media="screen" title="default style sheet" charset="utf-8" />
</head>

<body>
<div id="gallery-banner">
	<table cellspacing="0" cellpadding="0"><tr>
		<td><h1><a href="http://funkaoshi.com/">A Funkaoshi Production</a> presents <a href="/">IMG VQVZ</a>.</h1></td>
		<td align="right">What's Here: <a href="/">Home</a> | <a href="/about">About</a> | <a href="/sets">Sets</a></td>
    </tr></table>
</div>
<div id="content">
    <div id="header">
       <h2>About</h2>
    </div>
    <div class="photo hentry" id="about">
       <a href="http://www.flickr.com/photos/funkaoshi/4189316800/" title="Ricoh GR1s by funkaoshi, on Flickr"><img src="http://farm3.static.flickr.com/2501/4189316800_ff3675c6b4.jpg" width="500" height="322" alt="Ricoh GR1s" /></a>
       <%= @config[:about] %>
    </div>
</div>
<% unless @config[:analytics].nil? %>
<script type="text/javascript">
var gaJsHost = (("https:" == document.location.protocol) ? "https://ssl." : "http://www.");
document.write(unescape("%3Cscript src='" + gaJsHost + "google-analytics.com/ga.js' type='text/javascript'%3E%3C/script%3E"));
</script>
<script type="text/javascript">
try {
   var pageTracker = _gat._getTracker("<%= @config[:analytics] %>");
   pageTracker._trackPageview();
} catch(err) {}</script>
<% end %>
</body>

</html>

!!! 5
%html
  %head
    %meta(http-equiv="Content-Type" content="text/html; charset=utf-8")
    %title #{@config[:title]} :: #{@name.upcase}
    %link(rel="stylesheet" href="/css/vqvz.css" type="text/css" media="screen" title="default style sheet" charset="utf-8")
  %body
    = haml(:_gallery_banner, :layout => false)
    #content
      #header
        %h2= @name.capitalize
      #about.photo
        = haml("_#{@name}".to_sym, :layout => false)
    = haml(:_google_analytics, :layout => false)
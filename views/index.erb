<!DOCTYPE HTML>
<html lang=en>

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
  <title>VQVZ</title>
  <link rel="stylesheet" href="/css/vqvz.css"
    type="text/css" media="screen" title="default style sheet" charset="utf-8" />
  <link rel="stylesheet" href="/css/paging_keys.css"
    type="text/css" media="screen" title="paging keys css" charset="utf-8" />
  <script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.3.2/jquery.min.js"></script>
  <script type="text/javascript" src="/js/paging_keys.js"></script>
</head>

<!-- <%= @config[:user] %> | <%= @config[:user_id] %> | <%= @config[:tag] %> | <%= @page unless @page.nil? %> -->
<!-- <%= @tag %> -->

<body>
<div id="gallery-banner">
	<table cellspacing="0" cellpadding="0"><tr>
		<td><h1><a href="http://funkaoshi.com/">A Funkaoshi Production</a> presents <a href="/">IMG VQVZ</a>.</h1></td>
		<td align="right">What's Here: <a href="/">Home</a>
            | <a href="/about/">About</a> &nbsp; &nbsp; 
            <% unless @page == 0 %>
            Look Around: <% if @page > 1 %><a href="/page/<%= @page - 1 %>" class="prev_page">Prev</a><% else %>Prev<% end %>
            | <a href="/">Home</a> | 
            <% if @page < @config[:total_pages] %><a href="/page/<%= @page + 1 %>" class="next_page">Next</a><% else %>Next<% end %>
            <% end %>
    </tr></table>
</div>
<div id="content">
    <div id="header">
        <h1><%= @config[:title] %></h1>
        <h2><%= @config[:description] %></h2>
    </div>
    <% @sequence.each do |img| %>
    <div class="photo hentry" id="<% img.id %>">
        <a href="<%= img.flickr_url %>"><img src="<%= img.img_url %>" /></a>
    </div>
    <% end %>
</div>
<div id="footer">
  <span class="float_left">Everything here is copyright Ramanan Sivaranjan 2009.</span>
  <% unless @page == 0 %>
  <span class="float_right">
     <% if @page > 1 %><a href="/page/<%= @page - 1 %>" class="prev_page">Prev</a> | <% end %>
     page <%= @page %> of <%= @config[:total_pages] %>
     <% if @page < @config[:total_pages] %> | <a href="/page/<%= @page + 1 %>" class="next_page">Next</a><% end %></span>
  </span>
  <% end %>
  &nbsp;
</div>
<script type="text/javascript">
var gaJsHost = (("https:" == document.location.protocol) ? "https://ssl." : "http://www.");
document.write(unescape("%3Cscript src='" + gaJsHost + "google-analytics.com/ga.js' type='text/javascript'%3E%3C/script%3E"));
</script>
<script type="text/javascript">
try {
   var pageTracker = _gat._getTracker("UA-2675737-7");
   pageTracker._trackPageview();
} catch(err) {}</script>
</body>

</html>

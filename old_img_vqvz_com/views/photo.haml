!!! 5
%html
  %head
    = haml(:_meta, :layout => false)
    %title #{@config.conf[:title]} :: #{@photo.title}
    %link(rel="stylesheet" href="/css/vqvz.css" type="text/css" media="screen" title="default style sheet")
  %body
    = haml(:_gallery_banner, :layout => false)
    #content
      #header
        %h2= @photo.title
      .photo.hentry{:id => @photo.id}
        %a{:href => @photo.flickr_url}
          %img{:src => @photo.img_url}>
        %p(style="color:gray;margin-top:5em") Everything here is copyright Ramanan Sivaranjan 2009.
    = haml(:_trailer, :layout => false)

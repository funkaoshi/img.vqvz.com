!!! 5
%html
  %head
    = haml(:_meta, :layout => false)
    %title= @config.conf[:title]
    %link(rel="stylesheet" href="/css/vqvz.css" type="text/css" media="screen" title="default style sheet")
    %link(rel="stylesheet" href="/css/paging_keys.css" type="text/css" media="screen" title="paging keys css")
    %script(type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.4/jquery.min.js")
    %script(type="text/javascript" src="/js/paging_keys.js")
  / 
    user - #{@config.conf[:user]} | id - #{@config.conf[:user_id]} | tag - #{@tag} | page - #{@page}
  %body
    = haml(:_gallery_banner, :layout => false)
    #content
      #header
        %h2= @config.conf[:description]
      - @sequence.each do |img|
        .photo.hentry{:id => img.id}
          %a{:href => img.flickr_url}
            %img{:src => img.img_url}>
          .caption
            %p
              %a(href='/photo/#{img.id}')
                #{img.title}
            %p.date
              #{img.date}
    #footer
      %span.float_left Everything here is copyright Ramanan Sivaranjan 2009.
      - unless @page == 0 || @show_nav.nil?
        %span.float_right #{prev_link} | Page #{@page} of #{@pages} | #{next_link}
    = haml(:_trailer, :layout => false)
